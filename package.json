{
  "name": "tonedrop",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "icon": "node build/generate-icon.js && bash build/make-icns.sh",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.tonedrop.app",
    "productName": "Tonedrop",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*"
    ]
  },
  "keywords": [],
  "author": "Frohrer",
  "license": "MIT",
  "description": "Transfer .m4r ringtones to iPhone over USB — no iTunes needed",
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "bplist-parser": "^0.3.2",
    "music-metadata": "^11.12.3",
    "plist": "^3.1.0",
    "usbmux-client": "^0.2.1"
  }
}
